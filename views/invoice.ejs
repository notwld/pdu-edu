<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="index, follow, max-snippet:500, max-image-preview:large, max-video-preview:-1">
    <!-- Canonical URL -->
    <link rel="canonical" href="https://pdu-edu.org/">
    <title>Order Confirmation</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js" integrity="sha512-GsLlZN/3F2ErC5ifS5QtgpiJtWd43JWSuIgh7mbzZ8zBps+dvLusV+eNQATqgA/HdeKFVgA5v3S/cIrLF7QnIg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f9f9f9;
            color: #333;
        }

        .container {
            width: 100%;
            max-width: 600px;
            margin: 20px auto;
            background: #ffffff;
            border: 1px solid #ddd;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        }

        .header {
            background: #0073e6;
            color: white;
            text-align: center;
            padding: 20px;
        }

        .header h1 {
            margin: 0;
        }

        .address {
            text-align: center;
            padding: 10px 20px;
        }

        .content {
            padding: 20px;
        }

        .content h3 {
            margin: 10px 0;
        }

        .content span {
            display: block;
            margin-bottom: 10px;
            line-height: 1.5;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
        }

        table th,
        table td {
            text-align: left;
            padding: 10px;
            border: 1px solid #ddd;
        }

        table th {
            background-color: #f4f4f4;
        }

        .footer {
            padding: 20px;
            font-size: 14px;
            color: #666;
            text-align: center;
        }

        .btn-container {
            text-align: center;
            margin: 20px 0;
        }

        .btn {
            padding: 10px 20px;
            background-color: #0073e6;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 16px;
        }

        .btn:hover {
            background-color: #005bb5;
        }
    </style>
</head>

<body>
    <div id="invoice" class="container">
        <div class="header">
            <img src="/assets/images/logo/logo.png">
        </div>
        <div class="address">
            <p>Professional Development Unit, LLC</p>
            <p>P.O. BOX 256</p>
            <p>10760 ENDURING FREEDOM DRIVE</p>
            <p>FORT DRUM, NEW YORK 13602</p>
        </div>
        <div class="content">
            <h3><%= enrollment.createdAt.toLocaleDateString() %></h3>
            <h3>Hello <%= user.name %>,</h3>
            <span>
                Thank you for purchasing the <%= courseName %>. Please retain this email as confirmation of your
                purchase. This email serves as your order confirmation, and you will receive a separate message with
                www.Zoom.com meeting access instructions.
            </span>
            <table>
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Quantity</th>
                        <th>Price</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><%= courseName %></td>
                        <td>1</td>
                        <td>$<%= enrollment.subtotal %></td>
                    </tr>
                </tbody>
            </table>
            <span>Date of purchase: <%= enrollment.createdAt.toLocaleDateString() %></span>
            <span>You paid: $<%= enrollment.subtotal %></span>
            <span>Payment Method: <%= enrollment.paymentType %></span>
        
        </div>
        <div class="footer">
            <span>Respectfully,</span>
            <span>Your PDU Support Team</span>
            <p>
                If you made your purchase with a credit card, the description/payee will appear as
                "Professional Development Unit (PDU), LLC" on your statement. Please notify the
                person who reviews the credit card statement that "PDU, LLC" is the authorized seller
                of this product.
            </p>
        </div>
    </div>

    <div class="btn-container">
        <button class="btn" onclick="saveInvoiceAsPDF()">Save as PDF</button>
    </div>
    <div class="btn-container">
        <a href="/my-learnings">
            <button class="btn">Back to My Learnings</button>
        </a>
    </div>

    <script>
        function saveInvoiceAsPDF() {
            const element = document.querySelector('.container'); // Replace '.container' with the selector for your invoice content
            const options = {
                margin: [10, 10, 10, 10], // Top, Left, Bottom, Right margins in mm
                filename: 'invoice.pdf', // Name of the PDF file
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2 },
                jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
            };

            html2pdf().set(options).from(element).save();
        }
    </script>
</body>

</html>
