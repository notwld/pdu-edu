                document.getElementById('participant-forms').addEventListener('click', (e) => {
                    if (e.target.classList.contains('remove-participant')) {
                        e.target.closest('.participant-form').remove();
                        participantCount--;
                        toggleRemoveButtons();
                    }
                });

                function toggleRemoveButtons() {
                    const removeButtons = document.querySelectorAll('.remove-participant');
                    removeButtons.forEach(button => button.classList.toggle('d-none', participantCount <= 1));
                }
                document.querySelector('.checkoutform').addEventListener('submit', function(e) {
    e.preventDefault();
    
    let isValid = true;
    let firstEmptyField = null;
    let missingFields = [];

    // Validate all participant forms
    const participantForms = document.querySelectorAll('.participant-form');
    participantForms.forEach((form, index) => {
        const participantNum = index + 1;
        
        // Required fields for each participant
        const requiredFields = {
            [`firstName[]`]: 'First Name',
            [`lastName[]`]: 'Last Name',
            [`businessEmail[]`]: 'Business Email',
            [`jobTitle[]`]: 'Job Title',
            [`companyName[]`]: 'Company Name',
            [`workPhone[]`]: 'Work Phone',
            [`address[]`]: 'Address',
            [`city[]`]: 'City',
            [`state[]`]: 'State',
            [`zipcode[]`]: 'Zip Code',
            [`country[]`]: 'Country'
        };

        // Check each required field within the participant form
        for (const [fieldName, fieldLabel] of Object.entries(requiredFields)) {
            const field = form.querySelector(`[name="${fieldName}"]`);
            if (!field) continue;

            const value = field.value.trim();
            if (!value) {
                isValid = false;
                field.classList.add('is-invalid');
                
                if (!firstEmptyField) {
                    firstEmptyField = field;
                }
                
                missingFields.push(`${fieldLabel} for Participant ${participantNum}`);
            } else {
                field.classList.remove('is-invalid');
            }
        }

        // Validate email format
        const emailField = form.querySelector('[name="businessEmail[]"]');
        if (emailField && emailField.value.trim()) {
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(emailField.value.trim())) {
                isValid = false;
                emailField.classList.add('is-invalid');
                missingFields.push(`Valid email address for Participant ${participantNum}`);
                if (!firstEmptyField) {
                    firstEmptyField = emailField;
                }
            }
        }

        // Check if mode (virtual/self-paced) is selected
        const modeSelected = form.querySelector('input[name^="mode"]:checked');
        if (!modeSelected) {
            isValid = false;
            missingFields.push(`Mode selection (Virtual or Self-paced) for Participant ${participantNum}`);
        }
    });

    // Validate billing information
    const billingFields = {
        'billing-first-name': 'Billing First Name',
        'billing-last-name': 'Billing Last Name',
        'billing-business-email': 'Billing Business Email',
        'billing-job-title': 'Billing Job Title',
        'billing-city': 'Billing City',
        'billing-country': 'Billing Country',
        'addressCompanyName': 'Billing Address',
        'billingWorkPhone': 'Billing Work Phone',
        'billingZipCode': 'Billing Zip Code',
        'stateBilling': 'Billing State'
    };

    // Check billing fields
    for (const [fieldId, fieldName] of Object.entries(billingFields)) {
        const field = document.getElementById(fieldId) || document.querySelector(`[name="${fieldId}"]`);
        if (!field) continue;

        const value = field.value.trim();
        if (!value) {
            isValid = false;
            field.classList.add('is-invalid');
            
            if (!firstEmptyField) {
                firstEmptyField = field;
            }
            
            missingFields.push(fieldName);
        } else {
            field.classList.remove('is-invalid');
        }
    }

    // Validate billing email format
    const billingEmail = document.getElementById('billing-business-email');
    if (billingEmail && billingEmail.value.trim()) {
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(billingEmail.value.trim())) {
            isValid = false;
            billingEmail.classList.add('is-invalid');
            missingFields.push('Valid billing email address');
            if (!firstEmptyField) {
                firstEmptyField = billingEmail;
            }
        }
    }

    // Check if payment method is selected
    const paymentMethods = document.querySelectorAll('input[name="paymentMode"]');
    const paymentMethodSelected = Array.from(paymentMethods).some(method => method.checked);
    if (!paymentMethodSelected) {
        isValid = false;
        missingFields.push('Payment Method');
    }
    

    if (!isValid) {
        if (firstEmptyField) {
            firstEmptyField.focus();
            firstEmptyField.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        
        // Show a single alert with all missing fields
        alert('Please fill in the following required fields:\n\n• ' + missingFields.join('\n• '));
        
        return false;
    }

    // If all validations pass, check payment method and handle accordingly
    const paymentMode = document.querySelector('input[name="paymentMode"]:checked')?.value;
    
    if (paymentMode === 'credit card') {
        // Handle Stripe checkout
        handleStripeCheckout(this);
    } else {
        // For other payment methods, submit normally
        this.submit();
    }
});
            </script>
            <script>
                // Coupon application logic
                (function() {
                    const applyBtn = document.getElementById('applyCouponBtn');
                    const codeInput = document.getElementById('couponCode');
                    const successEl = document.getElementById('couponSuccess');
                    const errorEl = document.getElementById('couponError');
                    const discountEl = document.getElementById('order-discount');
                    const totalEl = document.getElementById('order-total');
                    const hiddenCode = document.getElementById('appliedCouponCode');
                    const hiddenDiscount = document.getElementById('appliedCouponDiscount');
                    const subtotal = parseFloat('<%= course.price %>');

                    applyBtn.addEventListener('click', async function() {
                        const code = (codeInput.value || '').trim();
                        successEl.classList.add('d-none');
                        errorEl.classList.add('d-none');
                        if (!code) return;
                        try {
                            const resp = await fetch('/coupons/validate', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ code, subtotal })
                            });
                            const data = await resp.json();
                            if (!resp.ok || !data.valid) {
                                errorEl.textContent = data.message || 'Invalid coupon';
                                errorEl.classList.remove('d-none');
                                hiddenCode.value = '';
                                hiddenDiscount.value = '';
                                discountEl.textContent = '$0.00';
                                totalEl.textContent = `$${subtotal.toFixed(2)}`;
                                return;
                            }
                            hiddenCode.value = code.toUpperCase();
                            hiddenDiscount.value = String(data.discount);
                            discountEl.textContent = `$${Number(data.discount).toFixed(2)}`;
                            totalEl.textContent = `$${Number(data.total).toFixed(2)}`;
                            successEl.textContent = `Coupon applied: -$${Number(data.discount).toFixed(2)}`;
                            successEl.classList.remove('d-none');
                        } catch (err) {
                            errorEl.textContent = 'Error applying coupon';
                            errorEl.classList.remove('d-none');
                        }
                    });
                })();
                // Handle Stripe checkout
                async function handleStripeCheckout(form) {
                    // Show loading state
                    const submitBtn = form.querySelector('button[type="submit"]');
                    const originalText = submitBtn.textContent;
                    submitBtn.textContent = 'Processing...';
                    submitBtn.disabled = true;
                    
                    try {
                        // Submit form data to create enrollment
                        const formData = new FormData(form);
                        const response = await fetch('/enroll/', {
                            method: 'POST',
                            body: formData
                        });
                        
                        if (!response.ok) {
                            throw new Error(`HTTP error! status: ${response.status}`);
                        }
                        
                        const result = await response.json();
                        console.log('Server response:', result);
                        
                        if (result.redirectToCheckout) {
                            // Create Stripe Checkout session
                            const checkoutResponse = await fetch('/create-checkout-session', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                },
                                body: JSON.stringify({
                                    enrollmentId: result.enrollmentId
                                })
                            });
                            
                            const checkoutData = await checkoutResponse.json();
                            
                            if (checkoutData.url) {
                                // Redirect to Stripe Checkout
                                window.location.href = checkoutData.url;
                            } else {
                                alert('Error creating payment session. Please try again.');
                            }
                        } else {
                            console.error('Unexpected response format:', result);
                            if (result.message) {
                                alert('Error: ' + result.message);
                            } else {
                                alert('Error creating enrollment. Please try again.');
                            }
                        }
                    } catch (error) {
                        console.error('Error:', error);
                        alert('An error occurred. Please try again.');
                        
                        // Reset button state
                        submitBtn.textContent = originalText;
                        submitBtn.disabled = false;
                    }
                }
            </script>
</body>

