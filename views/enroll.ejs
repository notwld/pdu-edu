                                            </div>
                                            <div class="mb-3">
                                                <label for="job-title-1" class="form-label">Job Title</label>
                                                <input type="text" class="form-control" id="job-title-1"
                                                    name="jobTitle[]">
                                            </div>
                                            <div class="mb-3">
