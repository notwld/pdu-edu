<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="index, follow, max-snippet:500, max-image-preview:large, max-video-preview:-1">
    <!-- Canonical URL -->
    <link rel="canonical" href="https://pdu-edu.org/">
    <title>Course</title>

    <link rel="stylesheet" href="/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="/assets/css/select2.min.css">
    <link rel="stylesheet" href="/assets/css/slick.css">
    <link rel="stylesheet" href="/assets/css/magnific-popup.css">
    <link rel="stylesheet" href="/assets/css/jquery-ui.css">
    <link rel="stylesheet" href="/assets/css/plyr.css">
    <link rel="stylesheet" href="/assets/css/animate.css">
    <link rel="stylesheet" href="/assets/css/aos.css">
    <link rel="stylesheet" href="/assets/css/main.css">
    <link href="https://unpkg.com/video.js/dist/video-js.min.css" rel="stylesheet">

    <style>
        .video-container {
            background-color: black;
            aspect-ratio: 16 / 9;
        }

        .sidebar {
            overflow-y: auto;
            max-height: 100vh;            
            min-width: 30%;
            border-right: 1px solid #ddd;
        }

        .main-content {
            flex-grow: 1;
            width: 75%;
        }

        .active-module {
            background-color: #e0f0ff !important;
        }        
        .circular-chart {
            display: block;            
            max-width: 100px;
            max-height: 100px;
        }
        #circularProgress span{
            font-size: 14px;
        }

        .circle-bg {
            fill: none;
            stroke: #eee;
            stroke-width: 3.8;
        }
        #progressSection{
            justify-content: space-around;
        }
        .circle {
            fill: none;
            stroke-width: 2.8;
            stroke-linecap: round;
            stroke: #4caf50;
            transition: stroke-dasharray 0.3s ease;
        }

        .no-content {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100%;
            color: white;
        }
        .my-player-dimensions{
            width: 100%;
            height: 100%;
        }

        @media (max-width: 768px) {
            .sidebar {
                width: 100%;
                min-width: unset;
                border-right: none;
            }

            .main-content {
                width: 100%;
            }

            .container-fluid {
                flex-direction: column;
            }
        }
    </style>
</head>

<body class="bg-light">
    <%- include('header'); -%>
    <div class="container d-flex py-20">
        <!-- Main Content -->
        <main class="flex-grow-1 d-flex flex-column">
            <!-- Video Player -->
            <div class="video-container">
                <video
                    id="my-player"
                    class="video-js"
                    controls
                    preload="auto"                    
                    data-setup='{}'
                    oncontextmenu="return false"
                    controlsList="nodownload" 
                    >
                    <% if (course && course.chapters && course.chapters[0] && course.chapters[0].modules[0]) { %>
                        <source id="videoSource" src="<%= course.chapters[0].modules[0].videoUrl %>"
                            type="video/mp4">
                        <% } else { %>
                            <div class="no-content">No video selected</div>
                            <% } %>
                </video>
                
            </div>

            <!-- Course Details -->
            <div class="p-4 bg-white shadow">
                <h1 class="text-3xl fw-bold">
                    <%= course.title %>
                </h1>
                <p class="mt-2">
                    <%= course.description %>
                </p>
                <div class="d-flex gap-3 mt-3">
                    <span class="badge bg-success">Level: <%= course.level %></span>
                    <span class="badge bg-primary">
                        <%= course.chapters.length %> Lessons
                    </span>
                    <span class="badge bg-info">Category: <%= course.category %></span>
                    <span class="badge bg-warning">Duration: <%= course.duration %> Weeks</span>
                </div>
                <h3 class="mt-4">Instructor</h3>
                <% if (course.instructors && course.instructors.length> 0) { %>
                    <% course.instructors.forEach(instructor=> { %>
                        <p><strong>
                                <%= instructor.name %>
                            </strong> (<%= instructor.email %>)</p>
                        <% }) %>
                            <% } else { %>
                                <p>No instructors available.</p>
                                <% } %>
                                    <h3 class="mt-4">Key Features</h3>
                                    <ul class="list-group">
                                        <% course.keyFeatures.forEach(feature=> { %>
                                            <li class="list-group-item">
                                                <%= feature %>
                                            </li>
                                            <% }) %>
                                    </ul>
                                    <h3 class="mt-4">Reviews</h3>
                                    <% if (course.reviews && course.reviews.length> 0) { %>
                                        <ul class="list-group">
                                            <% course.reviews.forEach(review=> { %>
                                                <li class="list-group-item">
                                                    <%= review.student.name %> rated <%= review.rating %>
                                                    <span>
                                                        <%= review.content %>
                                                    </span>
                                                </li>
                                                <% }) %>
                                        </ul>
                                        <% } else { %>
                                            <p>No reviews available.</p>
                                            <% } %>
            </div>

            <!-- Progress and Certificate -->
            
        </main>

        <!-- Sidebar -->
        <aside class="sidebar bg-white shadow p-4">
            <div class="progress-container bg-white shadow p-4">
                <div id="progressSection" class="d-flex align-items-center gap-4">
                    <!-- Circular Progress Bar -->
                    <div id="circularProgress" style="position: relative; width: 100px; height: 100px;">
                        <svg viewBox="0 0 36 36" class="circular-chart">
                            <path class="circle-bg"
                                d="M18 2.0845a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0-31.831" />
                            <path class="circle" id="progressCircle" stroke-dasharray="0, 100"
                                d="M18 2.0845a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0-31.831" />
                        </svg>
                        <span id="progressText"
                            style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 1.2rem;">0%</span>
                    </div>
                    <!-- Certificate Button -->
                    <a 
                        href="/course/request-certificate/<%= user.id %>/<%= course.id %>"
                    id="certificateButton" class="btn btn-primary d-none">Request Certificate</a>
                </div>
            </div>
            <div class="p-20">
                <div>
                    <h4><%= course.title %></h4>
                </div>
                <hr>
                <% if (course.chapters && course.chapters.length> 0) { %>
                    <% course.chapters.forEach((chapter, chapterIndex)=> { %>
                        <h4 class="mt-3">
                            <%= chapter.title %>
                        </h4>
                    <ul class="list-unstyled">
                        <% chapter.modules.forEach((module, moduleIndex)=> { %>
                            <li class="p-10 border rounded my-2 module-item" data-video-url="<%= module.videoUrl %>"
                                data-chapter-index="<%= chapterIndex %>" data-module-index="<%= moduleIndex %>"
                                onclick="switchVideo(this)">
                                <div class="d-flex justify-content-between">
                                    <span>
                                        <%= module.title %>
                                    </span>
                                    <span>
                                        <%= module.duration %> hr
                                    </span>
                                </div>
                            </li>
                            <% }) %>
                    </ul>
                    <% }) %>
                        <% } else { %>
                            <p>No chapters available.</p>
                            <% } %>
            </div>
        </aside>
    </div>
    
    
    <%- include('footer'); -%>

    <script>
        const userId = <%= user.id %>;
        const courseId = <%= course.id %>;
        const progressText = document.getElementById("progressText");
        const progressCircle = document.getElementById("progressCircle");
        const certificateButton = document.getElementById("certificateButton");

        async function updateProgress() {
            try {
                const response = await fetch(`/course/progress/${userId}/${courseId}`);
                if (!response.ok) throw new Error("Failed to fetch progress");
                const { progress } = await response.json();
                progressText.textContent = `${progress}%`;
                progressCircle.setAttribute("stroke-dasharray", `${progress}, 100`);
                certificateButton.classList.toggle("d-none", progress < 100);
            } catch (error) {
                console.error("Error fetching progress:", error);
            }
        }

        async function markModuleComplete(chapterIndex, moduleIndex) {
            try {
                const response = await fetch("/course/progress/mark-complete", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ userId, courseId, chapterIndex, moduleIndex, completed: true }),
                });
                if (!response.ok) throw new Error("Failed to mark module complete");
                await updateProgress();
            } catch (error) {
                console.error("Error marking module complete:", error);
            }
        }

        certificateButton.addEventListener("click", () => alert("Certificate requested!"));

        document.querySelectorAll(".module-item").forEach((module) => {
            module.addEventListener("click", () => {
                const chapterIndex = module.getAttribute("data-chapter-index");
                const moduleIndex = module.getAttribute("data-module-index");
                markModuleComplete(chapterIndex, moduleIndex);
            });
        });

        updateProgress();
        function switchVideo(element) {
            // Get video URL from the clicked element
            const videoUrl = element.getAttribute('data-video-url');

            // Update the video source
            const videoPlayer = document.getElementById('videoPlayer');
            const videoSource = document.getElementById('videoSource');
            if (videoUrl) {
                videoSource.src = new URL(videoUrl.split('/').pop(), window.location.origin);
                videoPlayer.load(); // Reload the video
                videoPlayer.play(); // Optionally play the video
            }

            // Highlight the active module
            document.querySelectorAll('.module-item').forEach(item => {
                item.classList.remove('active-module');
            });
            element.classList.add('active-module');
        }
    </script>        
         <!-- Jquery js -->
         <script src="/assets/js/jquery-3.7.1.min.js"></script>
         <!-- Bootstrap Bundle Js -->
         <script src="/assets/js/boostrap.bundle.min.js"></script>
         <!-- select2 Js -->
         <script src="/assets/js/select2.min.js"></script>
         <!-- Phosphor Icon Js -->
         <script src="/assets/js/phosphor-icon.js"></script>
         <!-- Slick js -->
         <script src="/assets/js/slick.min.js"></script>
         <!-- Slick js -->
         <script src="/assets/js/counter.min.js"></script>
         <!-- magnific popup -->
         <script src="/assets/js/magnific-popup.min.js"></script>
         <!-- Jquery Ui js -->
         <script src="/assets/js/jquery-ui.js"></script>
         <!-- plyr Js -->
         <script src="/assets/js/plyr.js"></script>
         <!-- vanilla Tilt -->
         <script src="/assets/js/vanilla-tilt.min.js"></script>
         <!-- wow -->
         <script src="/assets/js/wow.min.js"></script>
     
         <script src="/assets/js/aos.js"></script>         
         <!-- main js -->
         <script src="/assets/js/main.js"></script>
</body>

</html>