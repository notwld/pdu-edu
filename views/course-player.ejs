<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="index, follow, max-snippet:500, max-image-preview:large, max-video-preview:-1">
    <!-- Canonical URL -->
    <link rel="canonical" href="https://pdu-edu.org/courses">
    <title>Course</title>

    <link rel="stylesheet" href="/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="/assets/css/select2.min.css">
    <link rel="stylesheet" href="/assets/css/slick.css">
    <link rel="stylesheet" href="/assets/css/magnific-popup.css">
    <link rel="stylesheet" href="/assets/css/jquery-ui.css">
    <link rel="stylesheet" href="/assets/css/plyr.css">
    <link rel="stylesheet" href="/assets/css/animate.css">
    <link rel="stylesheet" href="/assets/css/aos.css">
    <link rel="stylesheet" href="/assets/css/main.css">
    <link href="https://unpkg.com/video.js/dist/video-js.min.css" rel="stylesheet">

    <style>
        .video-container {
            background-color: black;
            aspect-ratio: 16 / 9;
        }

        .sidebar {
            overflow-y: auto;
            max-height: 100vh;
            min-width: 30%;
            border-right: 1px solid #ddd;
        }

        .main-content {
            flex-grow: 1;
            width: 75%;
        }

        .active-module {
            background-color: #e0f0ff !important;
        }

        .circular-chart {
            display: block;
            max-width: 100px;
            max-height: 100px;
        }

        #circularProgress span {
            font-size: 14px;
        }

        .circle-bg {
            fill: none;
            stroke: #eee;
            stroke-width: 3.8;
        }

        #progressSection {
            justify-content: space-around;
        }

        .circle {
            fill: none;
            stroke-width: 2.8;
            stroke-linecap: round;
            stroke: #4caf50;
            transition: stroke-dasharray 0.3s ease;
        }

        .no-content {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100%;
            color: white;
        }

        .my-player-dimensions {
            width: 100%;
            height: 100%;
        }

        .progress,
        .progress-stacked {
            font-size: 15px;
            height: auto;
        }

        .badge {
            font-size: 15px;
        }

        @media (max-width: 768px) {
            .sidebar {
                width: 100%;
                min-width: unset;
                border-right: none;
            }

            .main-content {
                width: 100%;
            }

            .container-fluid {
                flex-direction: column;
            }
        }
    </style>
</head>

<body class="bg-light">
    <%- include('header'); -%>
        <section class="breadcrumb py-120 bg-main-25 position-relative z-1 overflow-hidden mb-0">
            <img src="/assets/images/shapes/shape1.png" alt="" class="shape one animation-rotation d-md-block d-none">
            <img src="/assets/images/shapes/shape2.png" alt="" class="shape two animation-scalation d-md-block d-none">
            <img src="/assets/images/shapes/shape3.png" alt="" class="shape eight animation-walking d-md-block d-none">
            <img src="/assets/images/shapes/shape5.png" alt="" class="shape six animation-walking d-md-block d-none">
            <img src="/assets/images/shapes/shape4.png" alt="" class="shape four animation-scalation">
            <img src="/assets/images/shapes/shape4.png" alt="" class="shape nine animation-scalation">

            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <div class="breadcrumb__wrapper">
                            <h1 class="breadcrumb__title display-4 fw-semibold text-center">
                                <%= course.title %>
                            </h1>
                            <ul class="breadcrumb__list d-flex align-items-center justify-content-center gap-4">
                                <li class="breadcrumb__item">
                                    <a href="#" class="breadcrumb__link text-neutral-500 hover-text-main-600 fw-medium">
                                        <i class="text-lg d-inline-flex"></i> My Learning</a>
                                </li>
                                <li class="breadcrumb__item">
                                    <i class="text-neutral-500 d-flex ph-bold ph-caret-right"></i>
                                </li>
                                <li class="breadcrumb__item">
                                    <a href="#" class="breadcrumb__link text-neutral-500 hover-text-main-600 fw-medium">
                                    </a>
                                </li>
                                <li class="breadcrumb__item d-none">
                                    <i class="text-neutral-500 d-flex ph-bold ph-caret-right"></i>
                                </li>
                                <li class="breadcrumb__item">
                                    <span class="text-main-600">
                                        <%= course.title %>
                                    </span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <section class="course-details py-60 bg-main-25">
            <div class="container">
                <div class="row gy-4">
                    <div class="col-xl-8">
                        <!-- Details Content Start -->
                        <div class="course-details__content border border-neutral-30 rounded-12 bg-white p-12">
                            <video id="player" class="player" playsinline controls
                                data-poster="assets/images/thumbs/course-details-img.png">
                                <% if (course && course.chapters && course.chapters[0] && course.chapters[0].modules[0])
                                    { %>
                                    <source id="videoSource" src="<%= course.chapters[0].modules[0].videoUrl %>"
                                        type="video/mp4">
                                    <% } else { %>
                                        <div class="no-content">No video selected</div>
                                        <% } %>
                            </video>

                            <div class="p-20">
                                <h2 class="mt-24 mb-24">
                                    <%= course.title %>
                                </h2>
                                <p class="text-neutral-700">
                                    <%= course.description %>
                                </p>
                                <div class="d-flex gap-3 mt-3 py-10">
                                    <span class="badge bg-success">Level: <%= course.level %></span>
                                    <span class="badge bg-primary"># of lessons: <%= course.chapters.length %></span>
                                    <span class="badge bg-primary">Category: <%= course.category %></span>
                                    <span class="badge bg-primary">Duration: <%= course.duration %> Hours</span>
                                </div>
                                <span class="d-block border-bottom border-main-100 my-32"></span>
                                <h4 class="mb-16">Key Features:</h4>
                                <ul class="list-dotted d-flex flex-column gap-24">
                                    <% course.keyFeatures.forEach(feature=> { %>
                                        <li class="list-group-item">
                                            <%= feature %>
                                        </li>
                                        <% }) %>
                                </ul>
                                <span class="d-block border-bottom border-main-100 my-32"></span>
                                <h4 class="mb-16">Instructor:</h4>
                                <% if (course.instructors && course.instructors.length> 0) { %>
                                    <% course.instructors.forEach(instructor=> { %>
                                        <p>
                                            <%= instructor.name %>
                                                (<%= instructor.email %>)
                                        </p>
                                        <% }) %>
                                            <% } else { %>
                                                <p>No instructors available.</p>
                                                <% } %>
                            </div>
                        </div>
                        <!-- Details Content End -->
                    </div>

                    <div class="col-xl-4">
                        <div class="course-details__sidebar border border-neutral-30 rounded-12 bg-white p-24">
                            <h5 class="text-neutral- mb-10">Your progress</h5>
                            <!-- <div id="circularProgress" style="position: relative; width: 100px; height: 100px;">
                            <svg viewBox="0 0 36 36" class="circular-chart">
                                <path class="circle-bg"
                                    d="M18 2.0845a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0-31.831" />
                                <path class="circle" id="progressCircle" stroke-dasharray="0, 100"
                                    d="M18 2.0845a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0-31.831" />
                            </svg>
                            <span id="progressText"
                                style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 1.2rem;">0%</span>
                        </div>                                 -->
                            <div class="progress w-100 mb-20">
                                <div class="progress-bar progress-bar-striped" id="progressBar" role="progressbar"
                                    style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                                    0%
                                </div>
                            </div>

                            <h5 class="text-neutral- mb-10">Course list</h5>
                            <div class="accordion common-accordion style-three" id="accordionExampleTwo">
                                <% if (course.chapters && course.chapters.length> 0) { %>
                                    <% course.chapters.forEach((chapter, chapterIndex)=> { %>
                                        <div class="accordion-item">
                                            <h2 class="accordion-header bg-main-25">
                                                <button class="accordion-button bg-main-25" type="button"
                                                    data-bs-toggle="collapse"
                                                    data-bs-target="#collapse<%= chapterIndex %>" aria-expanded="true"
                                                    aria-controls="collapse<%= chapterIndex %>">
                                                    <%= chapter.title %>
                                                </button>
                                            </h2>
                                            <div id="collapse<%= chapterIndex %>" class="accordion-collapse collapse"
                                                data-bs-parent="#accordionExampleTwo">
                                                <div class="accordion-body p-0 bg-main-25">
                                                    <% chapter.modules.forEach((module, moduleIndex)=> { %>
                                                        <div class="curriculam-item"
                                                            data-chapter-index="<%= chapterIndex %>"
                                                            data-module-index="<%= moduleIndex %>">
                                                            <div class="flex-between gap-8 mt-10">
                                                                <a onclick="switchVideo('<%= module.videoUrl.replace(/\\/g, '/') %>')"
                                                                    class="text-neutral-500 fw-medium hover-text-main-600 d-block cursor-pointer">
                                                                    <span class="flex-align gap-12">
                                                                        <i
                                                                            class="text-xl d-flex ph-bold ph-video-camera"></i>
                                                                        <span class="text-line-1">
                                                                            <%= module.title %>
                                                                        </span>
                                                                    </span>
                                                                </a>
                                                                <span class="flex-align gap-12 flex-shrink-0">Duration:
                                                                    <%= module?.duration?.toFixed(2) %> mins</span>
                                                            </div>
                                                        </div>
                                                        <% }) %>

                                                </div>
                                            </div>
                                        </div>
                                        <% }) %>
                                            <% } else { %>
                                                <p>No chapters available.</p>
                                                <% } %>
                            </div>

                           
                        </div>
                    </div>
                </div>
            </div>
        </section>


        <%- include('footer'); -%>

            <script>
                const userId = <%= user?.id %>;
                const courseId = <%= course?.id %>;
                const progressText = document.getElementById("progressText");
                const progressBar = document.getElementById("progressBar");

                // Update progress bar
                async function updateProgress() {
                    try {
                        const response = await fetch(`/course/progress/${userId}/${courseId}`);
                        if (!response.ok) throw new Error("Failed to fetch progress");

                        const { progress } = await response.json();
                        const progressValue = Math.max(0, Math.min(100, progress)); // Ensure progress stays between 0-100

                        // Update the progress bar width and text
                        if (progressBar) {
                            progressBar.style.width = `${progressValue}%`;
                            progressBar.setAttribute("aria-valuenow", progressValue);
                            progressBar.textContent = `${progressValue}%`;
                        }

                        
                    } catch (error) {
                        console.error("Error fetching progress:", error);
                    }
                }

                // Mark module as complete
                async function markModuleComplete(chapterIndex, moduleIndex) {
                    try {
                        const response = await fetch("/course/progress/mark-complete", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({ userId, courseId, chapterIndex, moduleIndex, completed: true }),
                        });
                        if (!response.ok) throw new Error("Failed to mark module complete");

                        // Update the progress bar after marking the module complete
                        await updateProgress();
                    } catch (error) {
                        console.error("Error marking module complete:", error);
                    }
                }

                // Event delegation for dynamically added modules
                document.addEventListener("click", (event) => {
                    const moduleItem = event.target.closest(".curriculam-item");
                    if (moduleItem) {
                        const chapterIndex = moduleItem.getAttribute("data-chapter-index");
                        const moduleIndex = moduleItem.getAttribute("data-module-index");
                        markModuleComplete(chapterIndex, moduleIndex);
                    }
                });

                // Initialize
                document.addEventListener("DOMContentLoaded", () => {
                    updateProgress();
                   
                   
                });

                function switchVideo(videoUrl) {
                    // Update the video source
                    const videoPlayer = document.getElementById('player');
                    const videoSource = document.getElementById('videoSource');
                    let url = videoUrl.split('/').pop()
                    console.log(url)
                    if (videoUrl) {
                        videoSource.src = window.location.origin + '/uploads/' + url;
                        videoPlayer.load(); // Reload the video
                    }
                }

                document.addEventListener('DOMContentLoaded', () => {
                    const initialVideoUrl = '<%= course.chapters[0].modules[0].videoUrl.replace(/\\/g, '/') %>';
                    if (initialVideoUrl) {
                        switchVideo(initialVideoUrl);
                    }
                });

            </script>
            <!-- Jquery js -->
            <script src="/assets/js/jquery-3.7.1.min.js"></script>
            <!-- Bootstrap Bundle Js -->
            <script src="/assets/js/boostrap.bundle.min.js"></script>
            <!-- select2 Js -->
            <script src="/assets/js/select2.min.js"></script>
            <!-- Phosphor Icon Js -->
            <script src="/assets/js/phosphor-icon.js"></script>
            <!-- Slick js -->
            <script src="/assets/js/slick.min.js"></script>
            <!-- Slick js -->
            <script src="/assets/js/counter.min.js"></script>
            <!-- magnific popup -->
            <script src="/assets/js/magnific-popup.min.js"></script>
            <!-- Jquery Ui js -->
            <script src="/assets/js/jquery-ui.js"></script>
            <!-- plyr Js -->
            <script src="/assets/js/plyr.js"></script>
            <!-- vanilla Tilt -->
            <script src="/assets/js/vanilla-tilt.min.js"></script>
            <!-- wow -->
            <script src="/assets/js/wow.min.js"></script>

            <script src="/assets/js/aos.js"></script>
            <!-- main js -->
            <script src="/assets/js/main.js"></script>
</body>

</html>