                                            </div>
                                            <div class="flex-align gap-8">
                                                <span class="text-neutral-700 text-2xl d-flex"><i
                                                        class="ph-bold ph-clock"></i></span>
                                                <span class="text-neutral-700 text-lg fw-medium">
                                                    <%= Math.floor(course.totalDuration / 60) %>h <%=
                                                            course.totalDuration % 60 %>m
                                                </span>
                                            </div>
                                            <div class="flex-align gap-8">
                                                <span class="text-neutral-700 text-2xl d-flex"><i
                                                        class="ph-bold ph-book"></i></span>
                                                <span class="text-neutral-700 text-lg fw-medium">
                                                    <%= course.chapters.length %> Lectures
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    <div
                                        class="flex-center pt-24 border-top border-neutral-50 mt-28 border-dashed border-0">
