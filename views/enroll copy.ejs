                                        </div>
                                        <div class="mb-3">
                                            <label for="billing-business-email" class="form-label">Business
                                                Email</label>
                                            <input type="email" class="form-control" id="billing-business-email"
                                                name="billingBusinessEmail">
                                        </div>
                                        <div class="mb-3">
                                            <label for="billing-city" class="form-label">City</label>
                                            <input type="text" class="form-control" id="billing-city"
                                                name="billingCity">
                                        </div>
                                        <div class="mb-3">
                                            <label for="billing-job-title" class="form-label">Company Name</label>
                                            <input type="text" class="form-control" id="billing-job-title"
                                                name="billingCompanyName">
                                        </div>
                                        <div class="mb-3">
                                            <label for="billing-job-title" class="form-label">Zip Code</label>
                                            <input type="text" class="form-control" id="billing-job-title"
                                                name="billingZipCode">
                                        </div>
                                        <div class="mb-3">
                                            <label for="billing-job-title" class="form-label">State</label>
                                            <input type="text" class="form-control" id="billing-job-title"
                                                name="stateBilling">
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label for="billing-last-name" class="form-label">Last Name</label>
                                            <input type="text" class="form-control" id="billing-last-name"
                                                name="billingLastName">
                                        </div>

                                        <div class="mb-3">
                                            <label for="billing-job-title" class="form-label">Job Title</label>
                                            <input type="text" class="form-control" id="billing-job-title"
                                                name="billingJobTitle">
                                        </div>
                                        <div class="mb-3">
                                            <label for="billing-country" class="form-label">Country</label>
                                            <select class="form-select" id="billing-country" name="billingCountry">
                                                <% countries.forEach(country=> { %>
                                                    <option value="<%= country.name %>">
                                                        <%= country.name %>
                                                    </option>
                                                    <% }); %>
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <label for="billing-job-title" class="form-label">Address</label>
                                            <input type="text" class="form-control" id="billing-job-title"
                                                name="addressCompanyName">
                                        </div>
                                        <div class="mb-3">
                                            <label for="billing-job-title" class="form-label">Apt. Suit, Appartment
                                                (Optional)</label>
                                            <input type="text" class="form-control" id="billing-job-title"
                                                name="billingApt">
                                        </div>
                                        <div class="mb-3">
                                            <label for="billing-job-title" class="form-label">Work Phone</label>
                                            <input type="text" class="form-control" id="billing-job-title"
                                                name="billingWorkPhone">
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Order Summary -->
                        <div class="col-lg-4">
                            <div class="order-summary border p-4 rounded">
                                <h3>Order Summary</h3>
                                <div class="d-flex justify-content-between">
                                    <span>
                                        <%= course.title %>
                                    </span>
                                    <span>$<%= course.price %></span>
                                </div>
                                <hr>
                                <div class="d-flex justify-content-between">
                                    <span>Subtotal</span>
                                    <span>$<%= course.price %></span>
                                </div>
                                <div class="d-flex flex-column my-5">
                                    <div class="">
                                        <label for="coupon" class="form-label">Goverment Pricing</label>
                                        <div class="d-flex">
                                            <input type="checkbox" name="govermentPricing" value="yes"
                                                id="govermentPricingYes">
                                            <label for="govermentPricingYes">Please check this box if you qualify for
                                                GSA
                                                pricing.</label>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex flex-column my-5">
                                    <div class="mb-5">
                                        <label for="coupon" class="form-label">Mode of Payment</label>
                                        <div class="d-flex">
                                            <input type="checkbox" name="govermentPricing" value="yes"
                                                id="govermentPricingYes">
                                            <label for="govermentPricingYes">Immediate payment by credit card.</label>
                                        </div>
                                    </div>
                                    <div class="mb-5">
                                        <label for="coupon" class="form-label">Mode of Payment</label>
                                        <div class="d-flex">
                                            <input type="checkbox" name="govermentPricing" value="yes"
                                                id="govermentPricingYes">
                                            <label for="govermentPricingYes">Prepaid Company Voucher</label>
                                        </div>
                                    </div>
                                    <div class="mb-5">
                                        <button class="btn btn-primary btn-lg w-100" type="submit">
                                            Checkout
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                </form>
            </div>
            </div>
        </section>

        <%- include('footer'); -%>

            <!-- Jquery js -->
            <script src="/assets/js/jquery-3.7.1.min.js"></script>
            <!-- Bootstrap Bundle Js -->
            <script src="/assets/js/boostrap.bundle.min.js"></script>
            <!-- select2 Js -->
