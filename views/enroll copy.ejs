            <div class="container mt-5">
                <form action="/enroll" method="post">
                    <div class="row">
                        <div class="col-lg-8">
                            <div class="breadcrumb__wrapper mb-4">
                                <h1 class="breadcrumb__title display-4 fw-semibold text-center">Enroll - <%=
                                        course.title %>
                                </h1>
                            </div>

                            <!-- Participants Form -->
                            <div id="participants-section p-5">
                                <h3 class="mb-3">Participants</h3>
                                <div id="participant-forms">
                                    <div class="participant-form border p-5 rounded mb-3">
                                        <h5 class="d-flex justify-content-between">
                                            Participant 1
                                            <button class="btn btn-danger btn-sm remove-participant d-none"
                                                disabled>Remove</button>
                                        </h5>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="mb-3">
                                                    <label for="first-name-1" class="form-label">First Name</label>
                                                    <input type="text" class="form-control" id="first-name-1"
                                                        name="firstName[]">
                                                </div>
                                                <div class="mb-3">
                                                    <label for="business-email-1" class="form-label">Business
                                                        Email</label>
                                                    <input type="email" class="form-control" id="business-email-1"
                                                        name="businessEmail[]">
                                                </div>
                                                <div class="mb-3">
                                                    <label for="company-name-1" class="form-label">Company Name</label>
                                                    <input type="text" class="form-control" id="company-name-1"
                                                        name="companyName[]">
                                                </div>
                                                <div class="mb-3">
                                                    <label for="work-phone-1" class="form-label">Work Phone</label>
                                                    <input type="text" class="form-control" id="work-phone-1"
                                                        name="workPhone[]">
                                                </div>
                                                <div class="mb-3">
                                                    <label for="city-1" class="form-label">City</label>
                                                    <input type="text" class="form-control" id="city-1" name="city[]">
                                                </div>
                                                <div class="mb-3">
                                                    <label for="zip-1" class="form-label">Zip Code</label>
                                                    <input type="text" class="form-control" id="zip-1" name="zipcode[]">
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="mb-3">
                                                    <label for="last-name-1" class="form-label">Last Name</label>
                                                    <input type="text" class="form-control" id="last-name-1"
                                                        name="lastName[]">
                                                </div>
                                                <div class="mb-3">
                                                    <label for="job-title-1" class="form-label">Job Title</label>
                                                    <input type="text" class="form-control" id="job-title-1"
                                                        name="jobTitle[]">
                                                </div>
                                                <div class="mb-3">
                                                    <label for="address-1" class="form-label">Address</label>
                                                    <input type="text" class="form-control" id="address-1"
                                                        name="address[]">
                                                </div>
                                                <div class="mb-3">
                                                    <label for="apt-1" class="form-label">Apt, Suite, etc
                                                        (Optional)</label>
                                                    <input type="text" class="form-control" id="apt-1" name="apt[]">
                                                </div>
                                                <div class="mb-3">
                                                    <label for="country-1" class="form-label">Country</label>
                                                    <select class="form-select" id="country-1" name="country[]">
                                                        <% countries.forEach(country=> { %>
                                                            <option value="<%= country.name %>">
                                                                <%= country.name %>
                                                            </option>
                                                            <% }); %>
                                                    </select>
                                                </div>
                                                <div class="mb-3">
                                                    <label for="state-1" class="form-label">State</label>
                                                    <input type="text" class="form-control" id="state-1" name="state[]">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            <label for="comment-1" class="form-label">Comments</label>
                                            <textarea class="form-control" id="comment-1" name="comments[]"></textarea>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" id="online-virtual-1"
                                                name="mode[0]" value="virtual">
                                            <label class="form-check-label" for="online-virtual-1">Virtual</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" id="online-self-paced-1"
                                                name="mode[0]" value="self-paced">
                                            <label class="form-check-label" for="online-self-paced-1">Self-paced</label>
                                        </div>
                                    </div>
                                </div>
                                <button class="btn btn-secondary" id="add-participant" type="button">+ Add Additional
                                    Participant</button>

                            </div>

                            <!-- Billing Address -->
                            <div class="my-5">
                                <h3 class="mb-3">Billing Address</h3>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label for="billing-first-name" class="form-label">First Name</label>
                                            <input type="text" class="form-control" id="billing-first-name"
