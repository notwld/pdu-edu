                                                <input type="text" class="form-control" id="address-1" name="address[]">
                                            </div>
                                            <div class="mb-3">
                                                <label for="apt-1" class="form-label">Apt, Suite, etc (Optional)</label>
                                                <input type="text" class="form-control" id="apt-1" name="apt[]">
                                            </div>
                                            <div class="mb-3">
                                                <label for="country-1" class="form-label">Country</label>
                                                <select class="form-select" id="country-1" name="country[]">
