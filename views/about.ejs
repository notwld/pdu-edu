                                            data-tilt-perspective="5000" data-tilt-full-page-listening>
                                    </div>
                                    <div class="col-sm-6">
                                        <div class="flex-align gap-24 mb-24">
                                           
                                            <div class="bg-neutral-700 rounded-12 text-center py-24 px-2 w-50-percent"
