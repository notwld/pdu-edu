                                                <h2 class="mb-0 text-white counter">3.2k</h2>
                                                <span class="text-white">Years of Experience</span>
                                            </div>
                                            <div class="bg-neutral-700 rounded-12 text-center py-24 px-2 w-50-percent"
                                                data-aos="fade-left">
                                                <h2 class="mb-0 text-white counter">25+</h2>
                                                <span class="text-white">PDU's Years of Experience</span>
                                            </div>
                                        </div>
                                        <img src="assets/images/thumbs/about-img2.png" alt="About Image 2"
                                            class="rounded-12 w-100" data-tilt data-tilt-max="20" data-tilt-speed="500"
