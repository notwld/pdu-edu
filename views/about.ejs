                                        <h6 class="mb-4">20% OFF</h6>
                                        <span class="text-neutral-500">For All Courses</span>
                                    </div>
                                </div>
                                <div class="row gy-4">
                                    <div class="col-sm-6">
                                        <img src="assets/images/thumbs/about-img1.png" alt="about image 1"
