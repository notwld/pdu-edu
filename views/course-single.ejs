<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="index, follow, max-snippet:500, max-image-preview:large, max-video-preview:-1">
    
    <!-- Canonical URL -->
    <link rel="canonical" href="https://pdu-edu.org/courses">

    <title>Dashboard - PDU ™</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/logo/favicon.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/images/logo/favicon.png">
    <link rel="apple-touch-icon" href="/assets/images/logo/favicon.png">

    <!-- Bootstrap -->
    <link rel="stylesheet" href="/assets/css/bootstrap.min.css">
    <!-- select2 -->
    <link rel="stylesheet" href="/assets/css/select2.min.css">
    <!-- Slick -->
    <link rel="stylesheet" href="/assets/css/slick.css">
    <!-- Slick -->
    <link rel="stylesheet" href="/assets/css/magnific-popup.css">
    <!-- jquery-ui -->
    <link rel="stylesheet" href="/assets/css/jquery-ui.css">
    <!-- plyr Css -->
    <link rel="stylesheet" href="/assets/css/plyr.css">
    <!-- animate -->
    <link rel="stylesheet" href="/assets/css/animate.css">

    <link rel="stylesheet" href="/assets/css/aos.css">
    <!-- Main css -->
    <link rel="stylesheet" href="/assets/css/main.css">
</head>

<body>
    <style>
        #v-pills-tab a {
            border: 2px solid #000;
            background: #fff;
            margin-bottom: 7px;
            border-radius: 0;
            font-size: 20px;
            color: #000;
            padding: 15px;
            display: flex;
            align-items: center;
        }
        #v-pills-tab .active{
            background-color: #000 !important;
            color: #fff !important;
        }
        .coursebox{
            min-height: 70vh;
            margin: 60px 0;
            box-shadow: var(--bs-box-shadow-sm) !important;
            background: #fff;
            border-radius: 7px;
        }
        #v-pills-tab a i {
            font-size: 24px;
            margin-right: 10px;
        }
        /* p{
            margin-bottom: 16px;
        } */
         .tab-content{
            width: 85%;
         }
        /* Forum styles */
        .forum-actions {
            display: flex !important;
            gap: 0.5rem;
            opacity: 1 !important;
            visibility: visible !important;
        }
        .forum-actions button {
            opacity: 1 !important;
            visibility: visible !important;
            display: inline-flex !important;
            align-items: center;
            gap: 0.25rem;
        }
        .list-group-item {
            position: relative;
            padding: 1rem;
        }
        .list-group-item .btn {
            opacity: 1 !important;
            visibility: visible !important;
            display: inline-flex !important;
            align-items: center;
            gap: 0.25rem;
            transition: all 0.2s ease;
            border: none;
        }
        .list-group-item .btn:hover {
            transform: translateY(-1px);
            filter: brightness(90%);
        }
        .list-group-item .btn-primary {
            background-color: #0d6efd;
            color: #fff;
        }
        .list-group-item .btn-danger {
            background-color: #dc3545;
            color: #fff;
        }
        /* Reply form styles */
        #replyForm-${comment.id} {
            display: none;
            margin-top: 1rem;
            padding: 1rem;
            background-color: #f8f9fa;
            border-radius: 0.25rem;
        }
        #replyForm-${comment.id}.show {
            display: block !important;
        }
        /* Comment form styles */
        #commentFormContainer {
            margin-top: 2rem;
            padding: 1rem;
            background-color: #f8f9fa;
            border-radius: 0.25rem;
        }
        #commentForm textarea {
            resize: vertical;
            min-height: 100px;
        }
        /* Forum status badges */
        .forum-status-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            padding: 0.25rem 0.5rem;
            border-radius: 0.25rem;
            font-size: 0.875rem;
            font-weight: 500;
        }
        .forum-status-badge.active {
            background-color: #198754;
            color: #fff;
        }
        .forum-status-badge.inactive {
            background-color: #dc3545;
            color: #fff;
        }
        .forum-status-badge.expired {
            background-color: #ffc107;
            color: #000;
        }
        /* Button styles */
        .btn {
            opacity: 1 !important;
            visibility: visible !important;
            display: inline-flex !important;
            align-items: center;
            gap: 0.25rem;
            transition: all 0.2s ease;
            border: none;
            font-weight: 500;
        }

        .btn:hover {
            transform: translateY(-1px);
            filter: brightness(90%);
        }

        /* Primary button */
        .btn-primary {
            background-color: #0d6efd !important;
            color: #fff !important;
        }

        /* Danger button */
        .btn-danger {
            background-color: #dc3545 !important;
            color: #fff !important;
        }

        /* Secondary button */
        .btn-secondary {
            background-color: #6c757d !important;
            color: #fff !important;
        }

        /* Light button */
        .btn-light {
            background-color: #f8f9fa !important;
            color: #212529 !important;
            border: 1px solid #dee2e6 !important;
        }

        /* Outline buttons */
        .btn-outline-primary {
            background-color: #0d6efd !important;
            color: #fff !important;
            border: none !important;
        }

        .btn-outline-danger {
            background-color: #dc3545 !important;
            color: #fff !important;
            border: none !important;
        }

        .btn-outline-secondary {
            background-color: #6c757d !important;
            color: #fff !important;
            border: none !important;
        }

        /* Modal styles */
        .modal-content {
            border: none;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        }

        .modal-header {
            background-color: #fff;
            border-bottom: 1px solid #dee2e6;
            padding: 1rem;
        }

        .modal-body {
            padding: 1.5rem;
        }

        .modal-footer {
            background-color: #fff;
            border-top: 1px solid #dee2e6;
            padding: 1rem;
        }

        /* Dropdown styles */
        .dropdown-menu {
            border: none;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        }

        .dropdown-item {
            padding: 0.5rem 1rem;
            transition: all 0.2s ease;
        }

        .dropdown-item:hover {
            background-color: #f8f9fa;
        }

        .dropdown-item.text-danger {
            color: #dc3545 !important;
        }

        .dropdown-item.text-danger:hover {
            background-color: #dc3545;
            color: #fff !important;
        }

        /* Forum action buttons */
        .forum-actions {
            display: flex !important;
            gap: 0.5rem;
            opacity: 1 !important;
            visibility: visible !important;
        }

        .forum-actions button {
            opacity: 1 !important;
            visibility: visible !important;
            display: inline-flex !important;
            align-items: center;
            gap: 0.25rem;
            padding: 0.375rem 0.75rem;
            font-size: 0.875rem;
        }

        /* Form control styles */
        .form-control {
            border: 1px solid #dee2e6;
            padding: 0.5rem 0.75rem;
            transition: border-color 0.2s ease;
        }

        .form-control:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
        }

        /* Badge styles */
        .badge {
            padding: 0.35em 0.65em;
            font-weight: 500;
        }

        .badge.bg-success {
            background-color: #198754 !important;
        }

        .badge.bg-danger {
            background-color: #dc3545 !important;
        }

        .badge.bg-warning {
            background-color: #ffc107 !important;
            color: #000 !important;
        }

        .badge.bg-info {
            background-color: #0dcaf0 !important;
            color: #fff !important;
        }

        .badge.bg-light {
            background-color: #f8f9fa !important;
            color: #212529 !important;
            border: 1px solid #dee2e6;
        }
    </style>
    <%- include('header'); -%>
        <% if (message) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <strong>
                    <%= message %>
                </strong>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
            <% } %>

            <section class="breadcrumb py-120 bg-main-25 position-relative z-1 overflow-hidden mb-0">
                <img src="/assets/images/shapes/shape1.png" alt=""
                    class="shape one animation-rotation d-md-block d-none">
                <img src="/assets/images/shapes/shape2.png" alt=""
                    class="shape two animation-scalation d-md-block d-none">
                <img src="/assets/images/shapes/shape3.png" alt=""
                    class="shape eight animation-walking d-md-block d-none">
                <img src="/assets/images/shapes/shape5.png" alt=""
                    class="shape six animation-walking d-md-block d-none">
                <img src="/assets/images/shapes/shape4.png" alt="" class="shape four animation-scalation">
                <img src="/assets/images/shapes/shape4.png" alt="" class="shape nine animation-scalation">

                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <div class="breadcrumb__wrapper">
                                <h1 class="breadcrumb__title display-4 fw-semibold text-center">
                                    <%= course?.title %>
                                </h1>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
                <div class="container-fluid mt-4">
                    <div class="coursebox">
                        <div class="row">
                        <!-- Vertical Tabs -->
                        <div class="col-md-3">
                            <ul class="nav flex-column nav-pills" id="v-pills-tab" role="tablist" aria-orientation="vertical">
                            <li class="nav-item">
                                <a class="nav-link active" id="v-pills-course-tab" data-bs-toggle="pill" href="#v-pills-course" role="tab" aria-controls="v-pills-course" aria-selected="true">
                                <i class="ph ph-file-text"></i> Course Status
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="v-pills-about-tab" data-bs-toggle="pill" href="#v-pills-about" role="tab" aria-controls="v-pills-about" aria-selected="false">
                                <i class="ph ph-info"></i> About
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="v-pills-videos-tab" data-bs-toggle="pill" href="#v-pills-videos" role="tab" aria-controls="v-pills-videos" aria-selected="false">
                                <i class="ph ph-video-camera"></i> Videos
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="v-pills-test-tab" data-bs-toggle="pill" href="#v-pills-test" role="tab" aria-controls="v-pills-test" aria-selected="false">
                                <i class="ph ph-pencil-simple"></i> Test
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="v-pills-forum-tab" data-bs-toggle="pill" href="#v-pills-forum" role="tab" aria-controls="v-pills-forum" aria-selected="false">
                                <i class="ph ph-chats"></i> Forum
                                </a>
                            </li>
                            </ul>
                        </div>
                    
                        <!-- Tab Content -->
                        <div class="col-md-9">
                            <div class="tab-content" id="v-pills-tabContent">
                            <div class="tab-pane fade show active" id="v-pills-course" role="tabpanel" aria-labelledby="v-pills-course-tab">
                                <h3>Course Status</h3>
                                <p>Track your lecture progress and complete the course to earn a certificate.</p>
                                <div class="progress w-100 mb-20 mt-10">
                                    <div class="progress-bar progress-bar-striped" id="progressBar" role="progressbar"
                                        style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                                        0%
                                    </div>
                                </div>
                                
                                
                                <h3>
                                    Your Test Attempts
                                </h3>
                                <div class="card shadow-sm mb-4 mt-10">
                                    <div class="card-header bg-light">
                                        <h5 class="mb-0">Test Progress Overview</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <div>
                                                <h6>Certificate Eligibility Status</h6>
                                                <span class="badge <%= isEligible ? 'bg-success' : 'bg-warning' %> fs-6">
                                                    <%= isEligible ? 'Eligible - All Tests Passed' : 'Not Eligible - Some Tests Pending' %>
                                                </span>
                                            </div>
                                            <div class="text-end">
                                                <h6>Tests Progress</h6>
                                                <span class="badge bg-info fs-6">
                                                    <%= attemptStats?.passedTests %>/<%= attemptStats?.totalTests %> Tests Passed
                                                </span>
                                                <% if (isEligible) { %>
                                                    <a href="/course/request-certificate/<%= user.id %>/<%= course.id %>" id="certificateButton"
                                                        class="btn btn-primary my-10 px-10 py-10" >Request Certificate
                                                    </a>
                                                    <% } %>
                                            </div>
                                            
                                        </div>
                                    </div>
                                </div>
                                <% if (attempts?.length === 0) { %>
                                    <p class="text-muted text-left">You haven't attempted any tests yet.</p>
                                <% } else { %>
                                    <% attempts?.forEach((attempt) => { %>
                                        <div class="card shadow-sm mb-4">
                                            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                                                <div>
                                                    <h5 class="mb-0"><%= attempt?.Test?.name %></h5>
                                                    <small class="text-muted">
                                                        <i class="bi bi-calendar me-1"></i>
                                                        <%= new Date(attempt?.createdAt).toLocaleDateString() %>
                                                    </small>
                                                </div>
                                                <div class="text-end">
                                                    <h6 class="mb-0">Overall Score</h6>
                                                    <span class="badge <%= attempt.isPassed ? 'bg-success' : 'bg-danger' %> fs-6">
                                                        <%= attempt?.correct %>/<%= attempt?.total %>
                                                        (<%= ((attempt?.correct/attempt?.total) * 100)?.toFixed(1) %>%)
                                                    </span>
                                                </div>
                                            </div>
                                            
                                            <div class="card-body">
                                                <div class="accordion" id="attempt<%= attempt.id %>">
                                                    <% attempt?.categories?.forEach((exam, examIndex) => { %>
                                                        <div class="accordion-item">
                                                            <h2 class="accordion-header">
                                                                <button class="accordion-button <%= examIndex === 0 ? '' : 'collapsed' %>" 
                                                                        type="button" 
                                                                        data-bs-toggle="collapse" 
                                                                        data-bs-target="#exam<%= attempt.id %>_<%= examIndex %>">
                                                                    <div class="d-flex justify-content-between align-items-center w-100">
                                                                        <span><%= exam.name %></span>
                                                                        <span class="badge <%= exam.score >= 75 ? 'bg-success' : 'bg-danger' %> ms-2">
                                                                            <%= exam.score.toFixed(1) %>%
                                                                        </span>
                                                                    </div>
                                                                </button>
                                                            </h2>
                                                            
                                                            <div id="exam<%= attempt.id %>_<%= examIndex %>" 
                                                                 class="accordion-collapse collapse <%= examIndex === 0 ? 'show' : '' %>"
                                                                 data-bs-parent="#attempt<%= attempt.id %>">
                                                                <div class="accordion-body">
                                                                    <div class="list-group">
                                                                        <% exam?.subCategories?.forEach((domain) => { %>
                                                                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                                                                <span><%= domain.name %></span>
                                                                                <div>
                                                                                    <div class="progress" style="width: 200px; height: 20px;">
                                                                                        <div class="progress-bar <%= domain.score >= 75 ? 'bg-success' : 'bg-danger' %>"
                                                                                             role="progressbar"
                                                                                             style="width: <%= domain.score %>%"
                                                                                             aria-valuenow="<%= domain.score %>"
                                                                                             aria-valuemin="0"
                                                                                             aria-valuemax="100">
                                                                                            <%= domain.score.toFixed(1) %>%
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        <% }) %>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    <% }) %>
                                                </div>
                                            </div>
                                    
                                            <div class="card-footer bg-light d-flex justify-content-between align-items-center">
                                                <small class="text-muted">
                                                    <i class="bi bi-check-circle-fill me-1"></i>
                                                    Status: <span class="<%= attempt.isPassed ? 'text-success' : 'text-danger' %>">
                                                        <%= attempt.isPassed ? 'Passed' : 'Failed' %>
                                                    </span>
                                                </small>
                                                <button class="btn btn-sm btn-outline-primary" 
                                                        onclick="window.location.href='/attempts/<%= attempt.id %>'">
                                                    View Details
                                                </button>
                                            </div>
                                        </div>
                                    <% }) %>
                                <% } %>

                                        
                                   
                            </div>
                            <div class="tab-pane fade" id="v-pills-test" role="tabpanel" aria-labelledby="v-pills-test-tab">
                                <h3>Test</h3>
                                <p>Take quizzes and practice tests to evaluate your knowledge.</p>
                                <div class="mt-10">
                                    <% if (course?.tests?.length === 0) { %>
                                        <p class="text-muted
                                        text-left">No tests available for this course.</p>
                                        <% } %>
                                    <% course?.tests?.forEach((test)=> { %>
                                        <div class="card p-3 mt-4">
                                            <div class="card-body d-flex justify-content-between align-items-center">
                                              <!-- Test Info -->
                                              <div class="d-flex flex-column">
                                                <div class="text-muted mb-1">
                                                  <i class="bi bi-clock-fill me-2"></i>
                                                  <span class="fw-medium"><%= test.name %></span>
                                                  <span class="ms-2">Duration: <%= test.duration %> Hours</span>
                                                </div>
                                                <div class="text-muted">
                                                  <i class="bi bi-bar-chart-fill me-2"></i>
                                                  <span>MCQs: <%= test.MCQ?.length || 0 %></span>
                                                </div>
                                              </div>
                                          
                                              <!-- Play Button -->
                                              <div class="flex-shrink-0">
                                                <a href="/test/<%= test.id %>" class="btn btn-light rounded-circle p-2" 
                                                   data-bs-toggle="tooltip" title="Start Test">
                                                  <img src="/assets/images/icons/play.png" 
                                                       class="img-fluid" 
                                                       style="width: 32px; height: 32px; object-fit: contain;"
                                                       alt="Play button">
                                                </a>
                                              </div>
                                            </div>
                                          </div>
                                        <% }); %>
                                </div>
                            </div>
                            <div class="tab-pane fade" id="v-pills-about" role="tabpanel" aria-labelledby="v-pills-about-tab">
                                <h3>About</h3>
                                <p>Learn more about the course and the instructors.</p>
                                <div class="mt-10">
                                    <h4>Course Description</h4>
                                    <p>
                                        <%= course?.description %>
                                    </p>
                                    <h4>Instructors</h4>
                                    <ul>
                                        <% course?.instructors?.forEach((instructor)=> { %>
                                            <li>
                                                <strong>
                                                    <%= instructor.name %>
                                                </strong>
                                                <p>
                                                    <%= instructor.email %>
                                                </p>
                                            </li>
                                            <% }); %>
                                    </ul>
                                    </div>
                            </div>
                            <div class="tab-pane fade" id="v-pills-videos" role="tabpanel" aria-labelledby="v-pills-videos-tab">
                                <h3>Videos</h3>
                                <p>Access video lectures and tutorials for the course.</p>
                                <div class="accordion common-accordion style-three mt-10" id="accordionExampleTwo">
                                    <% if (course.chapters && course.chapters.length> 0) { %>
                                        <% course.chapters.forEach((chapter, chapterIndex)=> { %>
                                            <div class="accordion-item">
                                                <h2 class="accordion-header bg-main-25">
                                                    <button class="accordion-button bg-main-25" type="button"
                                                        data-bs-toggle="collapse"
                                                        data-bs-target="#collapse<%= chapterIndex %>" aria-expanded="true"
                                                        aria-controls="collapse<%= chapterIndex %>">
                                                        <%= chapter.title %>
                                                    </button>
                                                </h2>
                                                <div id="collapse<%= chapterIndex %>" class="accordion-collapse collapse show"
                                                    data-bs-parent="#accordionExampleTwo">
                                                    <div class="accordion-body p-0 bg-main-25">
                                                        <% chapter.modules.forEach((module, moduleIndex)=> { %>
                                                            <div class="curriculam-item"
                                                                data-chapter-index="<%= chapterIndex %>"
                                                                data-module-index="<%= moduleIndex %>">
                                                                <div class="flex-between gap-8 mt-10">
                                                                    <a href="/my-learnings/courses/<%= course.slug %>"
                                                                        class="text-neutral-500 fw-medium hover-text-main-600 d-block cursor-pointer">
                                                                        <span class="flex-align gap-12">
                                                                            <i
                                                                                class="text-xl d-flex ph-bold ph-video-camera"></i>
                                                                            <span class="text-line-1">
                                                                                <%= module.title %>
                                                                            </span>
                                                                        </span>
                                                                    </a>
                                                                    <span class="flex-align gap-12 flex-shrink-0">Duration:
                                                                        <%= module?.duration?.toFixed(2) %> mins</span>
                                                                </div>
                                                            </div>
                                                            <% }) %>
    
                                                    </div>
                                                </div>
                                            </div>
                                            <% }) %>
                                                <% } else { %>
                                                    <p>No chapters available.</p>
                                                    <% } %>
                                </div>
                            </div>
                            <div class="tab-pane fade" id="v-pills-forum" role="tabpanel" aria-labelledby="v-pills-forum-tab">
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <div>
                                        <h3 class="mb-1">PMP Exam Q&As</h3>
                                        <div class="d-flex align-items-center gap-4 text-muted">
                                            <span class="d-flex align-items-center gap-1">
                                                <i class="ph ph-chats-circle"></i>
                                                <span id="totalTopics">0</span> Topics
                                            </span>
                                            <span class="d-flex align-items-center gap-1">
                                                <i class="ph ph-chat-circle-text"></i>
                                                <span id="totalReplies">0</span> Replies
                                            </span>
                                        </div>
                                    </div>
                                    <button class="btn btn-primary btn-lg d-flex align-items-center gap-2" onclick="createNewTopic()">
                                        <i class="ph ph-plus-circle"></i> Submit a Question
                                    </button>
                                </div>

                                <!-- Forum List -->
                                <div id="forumList" class="mt-4">
                                    <div class="card border-0 shadow-sm">
                                        <div class="card-body p-0">
                                            <div class="list-group list-group-flush" id="forumTopicsList">
                                                <!-- Forum topics will be loaded here -->
                                                <div class="text-center py-5">
                                                    <div class="spinner-border text-primary" role="status">
                                                        <span class="visually-hidden">Loading...</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Forum Detail View (hidden by default) -->
                                <div id="forumDetail" class="mt-4" style="display: none;">
                                    <div class="card border-0 shadow-sm">
                                        <div class="card-header bg-white border-bottom py-3">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>
                                                    <button class="btn btn-link text-decoration-none p-0 mb-2" onclick="backToForumList()">
