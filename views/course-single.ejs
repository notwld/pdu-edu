                    <script type="text/javascript">
                        const userId = <%= user?.id %>;
                        const courseId = <%= course?.id %>;
                          async function updateProgress() {
                    try {
                        const response = await fetch(`/course/progress/${userId}/${courseId}`);
                        if (!response.ok) throw new Error("Failed to fetch progress");

                        const { progress } = await response.json();
                        const progressValue = Math.max(0, Math.min(100, progress)); // Ensure progress stays between 0-100

                        // Update the progress bar width and text
                        if (progressBar) {
                            progressBar.style.width = `${progressValue}%`;
                            progressBar.setAttribute("aria-valuenow", progressValue);
                            progressBar.textContent = `${progressValue}%`;
                        }

                        
                    } catch (error) {
                        console.error("Error fetching progress:", error);
                    }
                }
                document.addEventListener("DOMContentLoaded", updateProgress);


                    </script>
                    
                    <!-- Forum Scripts -->
                    <script>
                    // Forum functionality
                        let currentForumId = null;
                    let currentUser = null;

                    // Fetch user data on page load
                    fetch('/api/user/me')
                        .then(response => response.json())
                        .then(data => {
                            if (data.user) {
                                currentUser = data.user;
                                // Enable forum creation if user is logged in
                                const createForumBtn = document.getElementById('createForumBtn');
                                if (createForumBtn) {
                                    createForumBtn.disabled = false;
                                }
                            }
                        })
                        .catch(error => console.error('Error fetching user:', error));

                    // Load forums for the course
                    function loadForums() {
                        const courseId = '<%= course.id %>';
                        console.log('Loading forums for course:', courseId);
                        console.log('API endpoint:', `/api/course/${courseId}/forums`);
                        
                        // Show loading state
                        const forumTopicsList = document.getElementById('forumTopicsList');
                        if (forumTopicsList) {
                            forumTopicsList.innerHTML = `
                                <div class="text-center py-5">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                </div>
                            `;
                        }
                        
                        fetch(`/api/course/${courseId}/forums`)
                            .then(async response => {
                                console.log('Forum list response status:', response.status);
                                console.log('Forum list response headers:', Object.fromEntries(response.headers.entries()));
                                if (!response.ok) {
                                    const text = await response.text();
                                    throw new Error(text || 'Failed to load forums');
                                }
                                return response.json();
                            })
                            .then(data => {
                                console.log('Forum list data received:', data);
                                const forumTopicsList = document.getElementById('forumTopicsList');
                                if (!forumTopicsList) {
                                    console.error('Forum topics list container not found');
                                    return;
                                }
                                
                                if (!data.forums || data.forums.length === 0) {
                                    forumTopicsList.innerHTML = `
                                        <div class="text-center py-5">
                                            <p class="text-muted mb-0">No forums available yet.</p>
                                        </div>
                                    `;
                                    return;
                                }
                                
                                // Update forum count
                                const totalTopics = document.getElementById('totalTopics');
                                if (totalTopics) {
                                    totalTopics.textContent = data.forums.length;
                                }
                                
                                // Calculate total replies
                                const totalReplies = data.forums.reduce((sum, forum) => sum + (forum._count?.comments || 0), 0);
                                const totalRepliesElement = document.getElementById('totalReplies');
                                if (totalRepliesElement) {
                                    totalRepliesElement.textContent = totalReplies;
                                }
                                
                                // Render forum list
                                forumTopicsList.innerHTML = data.forums.map(forum => {
                                    // Safely get creator name
                                    const creatorName = forum.createdBy?.name || 'Unknown User';
                                    const creatorCohort = forum.createdBy?.cohort;
                                    const lastActivityUserName = forum.lastActivityUser?.name;
                                    const commentCount = forum._count?.comments || 0;
                                    const viewCount = forum.viewCount || 0;
                                    const isExpired = forum.expiresAt && new Date(forum.expiresAt) < new Date();
                                    
                                    return `
                                    <div class="list-group-item list-group-item-action">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div class="flex-grow-1">
                                                <h5 class="mb-1">${forum.title || 'Untitled Forum'}</h5>
                                                <p class="mb-1 text-muted">${forum.description || 'No description provided'}</p>
                                                <div class="d-flex align-items-center gap-3 text-muted small">
                                                    <span class="d-flex align-items-center gap-1">
                                                        <i class="ph ph-user-circle"></i>
                                                        ${creatorName}
                                                        ${creatorCohort ? `<span class="badge bg-light text-dark ms-1">${creatorCohort}</span>` : ''}
                                                    </span>
                                                    <span class="d-flex align-items-center gap-1">
                                                        <i class="ph ph-clock"></i>
                                                        ${new Date(forum.createdAt).toLocaleString()}
                                                    </span>
                                                    <span class="d-flex align-items-center gap-1">
                                                        <i class="ph ph-eye"></i>
                                                        ${viewCount} views
                                                    </span>
                                                    <span class="d-flex align-items-center gap-1">
                                                        <i class="ph ph-chat-circle-text"></i>
                                                        ${commentCount} comments
                                                    </span>
                                                    ${!forum.isActive ? `
                                                        <span class="forum-status-badge inactive">Inactive</span>
                                                    ` : isExpired ? `
                                                        <span class="forum-status-badge expired">Expired</span>
                                                    ` : ''}
                                                </div>
                                            </div>
                                            <div class="forum-actions">
                                                <button onclick="viewForum(${forum.id})" class="btn btn-primary btn-sm">
                                                    <i class="ph ph-eye"></i> View Discussion
                                                </button>
                                                ${data.user && (data.user.role?.permissions?.some(p => p.name === 'Manage Forums') || forum.createdById === data.user.id) ? `
                                                    <button onclick="deleteForum('${forum.id}')" class="btn btn-danger btn-sm">
                                                        <i class="ph ph-trash"></i> Delete
                                                    </button>
                                                ` : ''}
                                            </div>
                                        </div>
                                        ${forum.lastActivityAt ? `
                                            <div class="mt-2 text-muted small">
                                                <i class="ph ph-clock-clockwise"></i>
                                                Last activity: ${new Date(forum.lastActivityAt).toLocaleString()}
                                                ${lastActivityUserName ? `by ${lastActivityUserName}` : ''}
                                            </div>
                                        ` : ''}
                                    </div>
                                    `;
                                }).join('');
                            })
                            .catch(error => {
                                console.error('Error loading forums:', error);
                                console.error('Error details:', {
                                    message: error.message,
                                    stack: error.stack,
                                    courseId: courseId
                                });
                                const forumTopicsList = document.getElementById('forumTopicsList');
                                if (forumTopicsList) {
                                    forumTopicsList.innerHTML = `
                                        <div class="text-center py-5">
                                            <p class="text-danger mb-0">Error loading forums. Please try again.</p>
                                        </div>
                                    `;
                                }
                            });
                    }
                    
                    // View forum details
                    function viewForum(forumId) {
                        console.log('Viewing forum:', forumId);
                        console.log('API endpoint:', `/api/forum/${forumId}/details`);
                        
                        currentForumId = forumId;
                        fetch(`/api/forum/${forumId}/details`)
                            .then(async response => {
                                console.log('Forum details response status:', response.status);
                                console.log('Forum details response headers:', Object.fromEntries(response.headers.entries()));
                                if (!response.ok) {
                                    const text = await response.text();
                                    throw new Error(text || 'Failed to load forum details');
                                }
                                return response.json();
                            })
                            .then(data => {
                                console.log('Forum details data received:', data);
                                const forumModal = document.getElementById('forumModal');
                                const forumContent = document.getElementById('forumContent');
                                if (!forumModal || !forumContent) return;

                                forumContent.innerHTML = `
                                    <div class="mb-6">
                                        <h2 class="text-2xl font-bold text-gray-800 mb-2">${data.forum.title}</h2>
                                        <p class="text-gray-600 mb-4">${data.forum.description}</p>
                                        <div class="text-sm text-gray-500">
                                            <span>Created by ${data.forum.createdBy.name}</span>
                                            ${data.forum.createdBy.cohort ? `<span class="ml-2">(${data.forum.createdBy.cohort})</span>` : ''}
                                            <span class="ml-2">• ${new Date(data.forum.createdAt).toLocaleString()}</span>
                                        </div>
                                                        </div>
                                    <div class="space-y-6">
                                        ${data.forum.comments.map(comment => `
                                            <div class="comment bg-gray-50 rounded-lg p-4">
                                                <div class="flex justify-between items-start mb-2">
                                                    <div class="text-sm text-gray-500">
                                                        <span class="font-semibold">${comment.user.name}</span>
                                                        ${comment.user.cohort ? `<span class="ml-2">(${comment.user.cohort})</span>` : ''}
                                                        <span class="ml-2">• ${new Date(comment.createdAt).toLocaleString()}</span>
                                                    </div>
                                                        </div>
                                                <p class="text-gray-700 mb-3">${comment.content}</p>
                                                <div class="replies ml-8 space-y-3">
                                                        ${comment.replies.map(reply => `
                                                        <div class="reply bg-white rounded p-3">
                                                            <div class="text-sm text-gray-500 mb-1">
                                                                <span class="font-semibold">${reply.user.name}</span>
                                                                ${reply.user.cohort ? `<span class="ml-2">(${reply.user.cohort})</span>` : ''}
                                                                <span class="ml-2">• ${new Date(reply.createdAt).toLocaleString()}</span>
                                                                        </div>
                                                            <p class="text-gray-700">${reply.content}</p>
                                                            </div>
                                                        `).join('')}
                                                    </div>
                                                ${data.user ? `
                                                    <div class="mt-3">
                                                        <button onclick="showReplyForm(${comment.id})" class="text-blue-500 hover:text-blue-700 text-sm">
                                                            Reply
                                                        </button>
                                                        <div id="replyForm-${comment.id}" class="hidden mt-2">
                                                            <textarea class="w-full p-2 border rounded" rows="2" placeholder="Write your reply..."></textarea>
                                                            <div class="mt-2 flex justify-end space-x-2">
                                                                <button onclick="hideReplyForm(${comment.id})" class="px-3 py-1 text-gray-600 hover:text-gray-800">
                                                                    Cancel
                                                                </button>
                                                                <button onclick="submitReply(${comment.id})" class="px-3 py-1 bg-blue-500 text-white rounded hover:bg-blue-600">
                                                                    Submit Reply
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                ` : ''}
                                            </div>
                                        `).join('')}
                                        </div>
                                    ${data.user ? `
                                        <div class="mt-6">
                                            <textarea id="newComment" class="w-full p-3 border rounded" rows="3" placeholder="Write your comment..."></textarea>
                                            <div class="mt-2 flex justify-end">
                                                <button onclick="submitComment()" class="px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600">
                                                    Post Comment
                                                </button>
                                        </div>
                                            </div>
                                    ` : `
                                        <div class="mt-6 text-center text-gray-500">
                                            Please log in to participate in the discussion.
                                            </div>
                                    `}
                                `;

                                forumModal.classList.remove('hidden');
                            })
                            .catch(error => {
                                console.error('Error loading forum details:', error);
                                console.error('Error details:', {
                                    message: error.message,
                                    stack: error.stack,
                                    forumId: forumId
                                });
                                alert('Error loading forum details. Please try again.');
                            });
                    }

                    // Submit a new comment
                    function submitComment() {
                        if (!currentForumId || !currentUser) {
                            console.log('Cannot submit comment:', { currentForumId, currentUser });
                            return;
                        }

                        const content = document.getElementById('newComment')?.value?.trim() || '';
                        console.log('Submitting comment:', { forumId: currentForumId, content });
                        console.log('API endpoint:', `/api/forum/${currentForumId}/comment`);

                        fetch(`/api/forum/${currentForumId}/comment`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ content })
                        })
                        .then(async response => {
                            console.log('Comment submission response status:', response.status);
                            console.log('Comment submission response headers:', Object.fromEntries(response.headers.entries()));
                            if (!response.ok) {
                                const text = await response.text();
                                throw new Error(text || 'Failed to post comment');
                            }
                            return response.json();
                        })
                        .then(data => {
                            console.log('Comment submission response:', data);
                            if (data.comment) {
                                document.getElementById('newComment').value = '';
                                viewForum(currentForumId); // Reload forum to show new comment
                            } else {
                                throw new Error(data.message || 'Failed to post comment');
                            }
                        })
                        .catch(error => {
                            console.error('Error posting comment:', error);
                            console.error('Error details:', {
                                message: error.message,
                                stack: error.stack,
                                forumId: currentForumId,
                                content: content
                            });
                            alert(error.message || 'Error posting comment. Please try again.');
                        });
                    }

                    // Show reply form for a comment
                    function showReplyForm(commentId) {
                        const replyForm = document.getElementById(`replyForm-${commentId}`);
                        if (replyForm) {
                            replyForm.classList.remove('hidden');
                        }
                    }

                    // Hide reply form
                    function hideReplyForm(commentId) {
                        const replyForm = document.getElementById(`replyForm-${commentId}`);
                        if (replyForm) {
                            replyForm.classList.add('hidden');
                            replyForm.querySelector('textarea').value = '';
                        }
                    }

                    // Submit a reply to a comment
                    function submitReply(commentId) {
                        if (!currentForumId || !currentUser) {
                            console.log('Cannot submit reply:', { currentForumId, currentUser, commentId });
                            return;
                        }

                        const replyForm = document.getElementById(`replyForm-${commentId}`);
                        const content = replyForm.querySelector('textarea').value.trim();
                        console.log('Submitting reply:', { forumId: currentForumId, commentId, content });
                        console.log('API endpoint:', `/api/forum/${currentForumId}/comment/${commentId}/reply`);

                        fetch(`/api/forum/${currentForumId}/comment/${commentId}/reply`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ content })
                        })
                        .then(async response => {
                            console.log('Reply submission response status:', response.status);
                            console.log('Reply submission response headers:', Object.fromEntries(response.headers.entries()));
                            if (!response.ok) {
                                const text = await response.text();
                                throw new Error(text || 'Failed to post reply');
                            }
                            return response.json();
                        })
                        .then(data => {
                            console.log('Reply submission response:', data);
                            if (data.reply) {
                                hideReplyForm(commentId);
                                viewForum(currentForumId); // Reload forum to show new reply
                            } else {
                                throw new Error(data.message || 'Failed to post reply');
                            }
                        })
                        .catch(error => {
                            console.error('Error posting reply:', error);
                            console.error('Error details:', {
                                message: error.message,
                                stack: error.stack,
                                forumId: currentForumId,
                                commentId: commentId,
                                content: content
                            });
                            alert(error.message || 'Error posting reply. Please try again.');
                        });
                    }

                    // Create a new forum
                    function createForum() {
                        if (!currentUser) {
                            console.log('Cannot create forum: User not logged in');
                            return;
                        }

                        const title = document.getElementById('topicTitle').value.trim();
                        const description = document.getElementById('topicDescription').value.trim();
                        const autoExpireAfter = document.querySelector('input[name="autoExpire"]:checked').value;
                        const courseId = '<%= course.id %>';

                        console.log('Creating new forum:', { title, description, autoExpireAfter, courseId });
                        console.log('API endpoint:', '/api/forum/create');

                        fetch('/api/forum/create', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({
                                title,
                                description,
                                courseId,
                                autoExpireAfter: autoExpireAfter || null
                            })
                        })
                        .then(response => {
                            console.log('Forum creation response status:', response.status);
                            console.log('Forum creation response headers:', Object.fromEntries(response.headers.entries()));
                            return response.json();
                        })
                        .then(data => {
                            console.log('Forum creation response:', data);
                            if (data.forum) {
                                // Close modal and reset form
                                const createForumModal = document.getElementById('createForumModal');
                                if (createForumModal) {
                                    createForumModal.classList.add('hidden');
                                }
                                document.getElementById('topicTitle').value = '';
                                document.getElementById('topicDescription').value = '';
                                document.getElementById('autoExpireAfter').value = '';
                                
                                // Reload forums
                                loadForums();
                            } else {
                                throw new Error(data.message || 'Failed to create forum');
                            }
                        })
                        .catch(error => {
                            console.error('Error creating forum:', error);
                            console.error('Error details:', {
                                message: error.message,
                                stack: error.stack,
                                title: title,
                                description: description,
                                courseId: courseId,
                                autoExpireAfter: autoExpireAfter
                            });
                            alert(error.message || 'Error creating forum. Please try again.');
                        });
                    }

                    // Delete a forum
                    function deleteForum(forumId) {
                        if (!forumId) {
                            console.error('No forum ID provided for deletion');
                            return;
                        }

                        console.log('Attempting to delete forum:', forumId);
                        console.log('API endpoint:', `/api/forum/${forumId}`);

                        if (!confirm('Are you sure you want to delete this forum? This action cannot be undone.')) {
                            console.log('Forum deletion cancelled by user');
                            return;
                        }

                        fetch(`/api/forum/${forumId}`, {
                            method: 'DELETE',
                            headers: {
                                'Content-Type': 'application/json'
                            }
                        })
                        .then(response => {
                            console.log('Forum deletion response status:', response.status);
                            if (!response.ok) {
                                throw new Error('Failed to delete forum');
                            }
                            return response.json();
                        })
                        .then(data => {
                            console.log('Forum deletion response:', data);
                            if (data.message === 'Forum deleted successfully') {
                                // If we're in the forum detail view, go back to the list
                                if (document.getElementById('forumDetail').style.display === 'block') {
                                    backToForumList();
                                }
                                // Reload forums list
                                loadForums();
                            } else {
                                throw new Error(data.message || 'Failed to delete forum');
                            }
                        })
                        .catch(error => {
                            console.error('Error deleting forum:', error);
                            console.error('Error details:', {
                                message: error.message,
                                stack: error.stack,
                                forumId: forumId
                            });
                            alert(error.message || 'Error deleting forum. Please try again.');
                        });
                    }

                    // Close forum modal
                    function closeForumModal() {
                        const forumModal = document.getElementById('forumModal');
                        if (forumModal) {
                            forumModal.classList.add('hidden');
                        }
                        currentForumId = null;
                    }

                    // Close create forum modal
                    function closeCreateForumModal() {
                        const createForumModal = document.getElementById('createForumModal');
                        if (createForumModal) {
                            createForumModal.classList.add('hidden');
                        }
                    }

                    // Load forums when the page loads
                    document.addEventListener('DOMContentLoaded', loadForums);

                    // Function to show forum list and hide forum detail
                    function backToForumList() {
                        document.getElementById('forumList').style.display = 'block';
                        document.getElementById('forumDetail').style.display = 'none';
                        currentForumId = null;
                    }

                    // Function to show forum detail and hide forum list
                    function showForumDetail() {
                        document.getElementById('forumList').style.display = 'none';
                        document.getElementById('forumDetail').style.display = 'block';
                    }

                    // Function to open new topic modal
                    function createNewTopic() {
                        const modal = new bootstrap.Modal(document.getElementById('newTopicModal'));
                        modal.show();
                    }

                    // Add event listeners for expiration type radio buttons
                    document.addEventListener('DOMContentLoaded', function() {
                        // Initial state setup
                        const presetOptions = document.getElementById('presetDurationOptions');
                        const customDateInput = document.getElementById('customDateInput');
                        const expirationTypeRadios = document.querySelectorAll('input[name="expirationType"]');
                        
                        // Set initial state based on checked radio
                        const checkedRadio = document.querySelector('input[name="expirationType"]:checked');
                        if (checkedRadio) {
                            if (checkedRadio.value === 'preset') {
                                presetOptions.style.display = 'flex';
                                customDateInput.style.display = 'none';
                            } else if (checkedRadio.value === 'custom') {
                                presetOptions.style.display = 'none';
                                customDateInput.style.display = 'block';
                            } else {
                                presetOptions.style.display = 'none';
                                customDateInput.style.display = 'none';
                            }
                        }

                        // Add change event listeners
                        expirationTypeRadios.forEach(radio => {
                            radio.addEventListener('change', function() {
                                if (this.value === 'preset') {
                                    presetOptions.style.display = 'flex';
                                    customDateInput.style.display = 'none';
                                    // Select first preset duration option by default
                                    const firstPresetOption = document.querySelector('input[name="autoExpire"]');
                                    if (firstPresetOption) {
                                        firstPresetOption.checked = true;
                                    }
                                } else if (this.value === 'custom') {
                                    presetOptions.style.display = 'none';
                                    customDateInput.style.display = 'block';
                                } else {
                                    presetOptions.style.display = 'none';
                                    customDateInput.style.display = 'none';
                                }
                            });
                        });
                    });

                    // Function to submit new topic
                    function submitNewTopic() {
                        const title = document.getElementById('topicTitle').value.trim();
                        const description = document.getElementById('topicDescription').value.trim();
                        const expirationType = document.querySelector('input[name="expirationType"]:checked').value;
                        
                        let expiresAt = null;
                        if (expirationType === 'preset') {
                            const hours = document.querySelector('input[name="autoExpire"]:checked')?.value;
                            if (hours) {
                                expiresAt = new Date();
                                expiresAt.setHours(expiresAt.getHours() + parseInt(hours));
                            }
                        } else if (expirationType === 'custom') {
                            const customDate = document.getElementById('customExpiryDate').value;
                            if (customDate) {
                                expiresAt = new Date(customDate);
                            }
                        }

                        if (!title || !description) {
                            alert('Please fill in all required fields');
                            return;
                        }

                        fetch('/api/forum/create', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({
                                title,
                                description,
                                courseId: '<%= course.id %>',
                                expiresAt: expiresAt ? expiresAt.toISOString() : null
                            })
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (data.forum) {
                                // Close modal
                                const modal = bootstrap.Modal.getInstance(document.getElementById('newTopicModal'));
                                modal.hide();
                                
                                // Reset form
                                document.getElementById('topicTitle').value = '';
                                document.getElementById('topicDescription').value = '';
                                document.getElementById('customExpiryDate').value = '';
                                document.querySelector('input[name="expirationType"][value="none"]').checked = true;
                                document.getElementById('presetDurationOptions').style.display = 'none';
                                document.getElementById('customDateInput').style.display = 'none';
                                
                                // Reload forums
                                loadForums();
                            } else {
                                throw new Error(data.message || 'Failed to create forum');
                            }
                        })
                        .catch(error => {
                            console.error('Error creating forum:', error);
                            alert(error.message || 'Error creating forum. Please try again.');
                        });
                    }

                    // View forum details
                    function viewForum(forumId) {
                        console.log('Viewing forum:', forumId);
                        currentForumId = forumId;
                        
                        // Show loading state
                        document.getElementById('forumList').style.display = 'none';
                        document.getElementById('forumDetail').style.display = 'block';
                        document.getElementById('commentsList').innerHTML = `
                            <div class="text-center py-5">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            </div>
                        `;
                        
                        fetch(`/api/forum/${forumId}/details`)
                            .then(response => {
                                if (!response.ok) {
                                    throw new Error('Failed to load forum details');
                                }
                                return response.json();
                            })
                            .then(data => {
                                if (!data.forum) {
                                    throw new Error('Forum not found');
                                }

                                // Update forum detail view
                                document.getElementById('forumTitle').textContent = data.forum.title;
                                document.getElementById('forumDescription').textContent = data.forum.description;
                                document.getElementById('forumAuthor').textContent = data.forum.createdBy?.name || 'Unknown User';
                                document.getElementById('forumCohort').textContent = data.forum.createdBy?.cohort || '';
                                document.getElementById('forumDate').textContent = new Date(data.forum.createdAt).toLocaleString();
                                document.getElementById('forumViews').textContent = data.forum.viewCount || 0;

                                // Handle last activity
                                const lastActivityContainer = document.getElementById('lastActivityContainer');
                                if (data.forum.lastActivityAt) {
                                    lastActivityContainer.style.display = 'inline-flex';
                                    document.getElementById('lastActivityTime').textContent = new Date(data.forum.lastActivityAt).toLocaleString();
                                    document.getElementById('lastActivityUser').textContent = data.forum.lastActivityUser?.name || 'Unknown User';
                                    document.getElementById('lastActivityCohort').textContent = data.forum.lastActivityUser?.cohort || '';
                                } else {
                                    lastActivityContainer.style.display = 'none';
                                }

                                // Handle forum status
                                const forumStatus = document.getElementById('forumStatus');
                                if (!data.forum.isActive) {
                                    forumStatus.innerHTML = '<span class="badge bg-danger">Inactive</span>';
                                } else if (data.forum.expiresAt && new Date(data.forum.expiresAt) < new Date()) {
                                    forumStatus.innerHTML = '<span class="badge bg-warning">Expired</span>';
                                } else {
                                    forumStatus.innerHTML = '';
                                }

                                // Handle forum actions
                                const forumActions = document.getElementById('forumActions');
                                if (data.user && (data.user.role?.permissions?.some(p => p.name === 'Manage Forums') || data.forum.createdById === data.user.id)) {
                                    forumActions.style.display = 'block';
                                } else {
                                    forumActions.style.display = 'none';
                                }

                                // Render comments
                                const commentsList = document.getElementById('commentsList');
                                if (data.forum.comments.length === 0) {
                                    commentsList.innerHTML = '<p class="text-muted text-center py-4">No comments yet. Be the first to comment!</p>';
                                } else {
                                    commentsList.innerHTML = data.forum.comments.map(comment => `
                                        <div class="card mb-3">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between align-items-start mb-2">
                                                    <div>
                                                        <h6 class="mb-0">${comment.user?.name || 'Unknown User'}</h6>
                                                        ${comment.user?.cohort ? `<span class="badge bg-light text-dark">${comment.user.cohort}</span>` : ''}
                                                        <small class="text-muted d-block">${new Date(comment.createdAt).toLocaleString()}</small>
                                                    </div>
                                                </div>
                                                <p class="mb-2">${comment.content}</p>
                                                
                                                <!-- Replies -->
                                                ${comment.replies.length > 0 ? `
                                                    <div class="ms-4 mt-3">
                                                        ${comment.replies.map(reply => `
                                                            <div class="card mb-2">
                                                                <div class="card-body py-2">
                                                                    <div class="d-flex justify-content-between align-items-start">
                                                                        <div>
                                                                            <h6 class="mb-0">${reply.user?.name || 'Unknown User'}</h6>
                                                                            ${reply.user?.cohort ? `<span class="badge bg-light text-dark">${reply.user.cohort}</span>` : ''}
                                                                            <small class="text-muted d-block">${new Date(reply.createdAt).toLocaleString()}</small>
                                                                        </div>
                                                                    </div>
                                                                    <p class="mb-0 mt-1">${reply.content}</p>
                                                                </div>
                                                            </div>
                                                        `).join('')}
                                                    </div>
                                                ` : ''}

                                                <!-- Reply form -->
                                                ${data.user ? `
                                                    <div class="mt-3">
                                                        <button onclick="showReplyForm(${comment.id})" class="btn btn-link btn-sm p-0">
                                                            <i class="ph ph-reply"></i> Reply
                                                        </button>
                                                        <div id="replyForm-${comment.id}" class="mt-2" style="display: none;">
                                                            <textarea class="form-control mb-2" rows="2" placeholder="Write your reply..."></textarea>
                                                            <div class="d-flex gap-2">
                                                                <button onclick="hideReplyForm(${comment.id})" class="btn btn-secondary btn-sm">Cancel</button>
                                                                <button onclick="submitReply(${comment.id})" class="btn btn-primary btn-sm">Submit Reply</button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                ` : ''}
                                            </div>
                                        </div>
                                    `).join('');
                                }

                                // Show/hide comment form based on user login status
                                document.getElementById('commentFormContainer').style.display = data.user ? 'block' : 'none';
                            })
                            .catch(error => {
                                console.error('Error loading forum details:', error);
                                document.getElementById('commentsList').innerHTML = `
                                    <div class="alert alert-danger m-3">
                                        Error loading forum details. Please try again.
                                    </div>
                                `;
                            });
                    }
                    </script>
                    <!-- Jquery js -->
                    <script src="/assets/js/jquery-3.7.1.min.js"></script>
                    <!-- Bootstrap Bundle Js -->
                    <script src="/assets/js/boostrap.bundle.min.js"></script>
                    <!-- select2 Js -->
                    <script src="/assets/js/select2.min.js"></script>
                    <!-- Phosphor Icon Js -->
                    <script src="/assets/js/phosphor-icon.js"></script>
                    <!-- Slick js -->
                    <script src="/assets/js/slick.min.js"></script>
                    <!-- Slick js -->
                    <script src="/assets/js/counter.min.js"></script>
                    <!-- magnific popup -->
                    <script src="/assets/js/magnific-popup.min.js"></script>
                    <!-- Jquery Ui js -->
                    <script src="/assets/js/jquery-ui.js"></script>
                    <!-- plyr Js -->
                    <script src="/assets/js/plyr.js"></script>
                    <!-- vanilla Tilt -->
                    <script src="/assets/js/vanilla-tilt.min.js"></script>
                    <!-- wow -->
                    <script src="/assets/js/wow.min.js"></script>

                    <script src="/assets/js/aos.js"></script>

                    <!-- main js -->
                    <script src="/assets/js/main.js"></script>

                    <script>
                        // Add smooth animations on page load
                        document.addEventListener('DOMContentLoaded', function() {
                            const cards = document.querySelectorAll('.course-card');
                            cards.forEach((card, index) => {
                                card.style.opacity = '0';
                                card.style.transform = 'translateY(20px)';
                                
                                setTimeout(() => {
                                    card.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
                                    card.style.opacity = '1';
                                    card.style.transform = 'translateY(0)';
                                }, index * 100);
                            });
                        });

                        // Add click animation to forum buttons
                        document.querySelectorAll('.btn-forums').forEach(btn => {
                            btn.addEventListener('click', function(e) {
                                this.style.transform = 'scale(0.95)';
                                setTimeout(() => {
                                    this.style.transform = '';
                                }, 150);
                            });
                        });

                        // Check for tab parameter and open the appropriate tab
                        const urlParams = new URLSearchParams(window.location.search);
                        const tabParam = urlParams.get('tab');
                        
                        if (tabParam === 'forum') {
                            // Activate the forum tab
                            const forumTab = document.getElementById('v-pills-forum-tab');
                            const forumPane = document.getElementById('v-pills-forum');
                            
                            if (forumTab && forumPane) {
                                // Remove active class from all tabs and panes
                                document.querySelectorAll('#v-pills-tab .nav-link').forEach(tab => {
                                    tab.classList.remove('active');
                                });
                                document.querySelectorAll('#v-pills-tabContent .tab-pane').forEach(pane => {
                                    pane.classList.remove('show', 'active');
                                });
                                
                                // Activate forum tab and pane
                                forumTab.classList.add('active');
                                forumPane.classList.add('show', 'active');
                                
                                // Load forums after tab is shown
                                setTimeout(() => {
                                    if (typeof loadForums === 'function') {
                                        loadForums();
                                    }
                                }, 100);
                            }
                        }
                    </script>
</body>

</html>